  "meta": {
    "updated": "2026-10-02",
    "unavailableHosts": [
      "https://github.com/Swarm-Official/"
    ],
    "unavailableNote": "Rows whose url starts with one of unavailableHosts were published on a host that no longer answers (the Swarm-Official organisation is suspended). The pages render them as being re-published instead of a dead button, and tools/check_downloads.mjs lists them as paused. Repoint url and checksums to louisinthesubway/swarm-releases as each file is uploaded again; the SHA-256 stays the same.",
    "pauseReasons": {
      "restart-2026-10-02": "was built for the first SWARM chain and cannot connect to the mainnet restarted on 2 October 2026."
    },
    "pauseNote": "An entry with \"paused\": \"<key of pauseReasons>\" (or a plain reason) is published but must not be offered: the pages draw \"New version for the restarted network is being published\" instead of its buttons and checksum, and tools/check_downloads.mjs lists it as paused. A platform that also has an available entry without the flag shows that entry and hides the paused one, so adding the new rows is enough; delete the old rows (or the flag) when they go.",
    "note": "Download metadata for the Ecosystem block on the home page, the /ecosystem hub and the app pages. Mainnet builds are the downloads; testnet builds are kept under \"channel\": \"testnet\" and rendered in their own labelled section. After updating entries, run python tools/build_ecosystem.py and verify with --check. Every available entry must have a working URL, version, SHA-256 and byte size.",
    "windowsNotice": "Unsigned build — Windows SmartScreen will warn. Check the SHA-256.",
    "mobileNotice": "Mobile apps are wallets only — phones do not mine.",
    "sourceUrl": "https://github.com/louisinthesubway",
    "sourceNote": "Owner rule 2026-09-28: downloads are served from SWARM's own server (lwd-main.swarm.green/downloads/<tag>/<file>); github.com is never linked for a download. sourceUrl is the code; releasesUrl is only a record.",
    "releasesUrl": "https://github.com/louisinthesubway/swarm-releases",
    "releasesLabel": "All mainnet downloads and checksums: github.com/louisinthesubway/swarm-releases",
    "unsignedNotice": "Unsigned build — your system will warn. Check the SHA-256.",
    "macosNotice": "SWARM Wallet for macOS is signed and notarized. It is one app for Apple silicon and Intel.",
    "walletUpdate": {
      "title": "SWARM mainnet was restarted on 2 October 2026",
      "text": "SWARM Wallet 0.1.0-mainnet.10 for Windows, macOS (Apple silicon and Intel) and Linux is the version for the restarted network; Android follows. Earlier builds (desktop 0.1.0-mainnet.9, Android 0.2.0-mainnet.4) were made for the first chain and cannot connect. Install the new version over the old one: your addresses and recovery phrase stay the same, the wallet keeps a backup copy of its file and starts again from the new chain, where balances begin at zero because the coins of the first chain do not exist on it.",
      "url": "",
      "label": "Read the release notes"
    },
    "messengerNotice": "Unsigned build (0.1.1) — Windows SmartScreen and macOS Gatekeeper will warn. Check the SHA-256. Sign in with a new or existing 24-word phrase; there is no phone number."
  },
